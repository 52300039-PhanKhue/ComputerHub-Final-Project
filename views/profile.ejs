<%- include('partials/header',{title:'Tài khoản - ComputerHub'}) %>
<div class="profile-head"><div class="profile-chip"><span class="profile-avatar"><%= profile.full_name.slice(0,1).toUpperCase() %></span><div><span class="kicker">My account</span><h1 class="page-title" style="font-size:34px"><%= profile.full_name %></h1><div class="muted small">Thành viên từ <%= dateTime(profile.created_at) %></div></div></div><a class="btn secondary" href="/products">Tiếp tục mua sắm</a></div>
<div class="profile-grid">
  <section class="panel"><h2>Thông tin cá nhân</h2><p class="panel-subtitle">Cập nhật tên và email tài khoản.</p><form method="post"><label>Họ và tên</label><input name="full_name" value="<%= profile.full_name %>" required><label>Email</label><input type="email" name="email" value="<%= profile.email %>" required><button class="btn">Lưu thay đổi</button></form><div class="loyalty-box"><span class="small muted">Điểm thành viên hiện có</span><b><%= profile.loyalty_points %> điểm</b><span class="small muted">Tương đương <%= money(profile.loyalty_points*POINT_VALUE_VND) %> khi sử dụng.</span></div></section>
  <section class="panel"><h2>Bảo mật</h2><p class="panel-subtitle"><%= hasPassword?'Đổi mật khẩu bằng cách xác nhận mật khẩu hiện tại.':'Tài khoản mới chưa có mật khẩu. Hãy tạo mật khẩu trước khi đăng xuất.' %></p><form method="post" action="/profile/password"><% if(hasPassword){ %><label>Mật khẩu hiện tại</label><input type="password" name="current_password" placeholder="Mật khẩu hiện tại" required><% } %><label><%= hasPassword?'Mật khẩu mới':'Tạo mật khẩu đăng nhập' %></label><input type="password" name="new_password" minlength="8" placeholder="Tối thiểu 8 ký tự" required><button class="btn"><%= hasPassword?'Đổi mật khẩu':'Tạo mật khẩu' %></button></form></section>
</div>
<section class="panel"><div class="section-head"><div><h2>Địa chỉ giao hàng</h2><p class="panel-subtitle">Lưu nhiều địa chỉ, chọn mặc định hoặc xóa địa chỉ không còn dùng.</p></div></div><div class="address-grid"><% addresses.forEach(a=>{ %><article class="address <%= a.is_default?'default':'' %>"><h4><%= a.label %> <% if(a.is_default){ %><span class="badge">Mặc định</span><% } %></h4><p><b><%= a.recipient_name %></b> — <%= a.phone||'Chưa có SĐT' %></p><p><%= a.address_line %></p><div class="address-actions"><% if(!a.is_default){ %><form method="post" action="/profile/addresses/<%= a.id %>/default"><button class="btn secondary small-btn">Đặt mặc định</button></form><% } %><form method="post" action="/profile/addresses/<%= a.id %>/delete" data-confirm="Xóa địa chỉ này?"><button class="danger">Xóa</button></form></div></article><% }) %></div><form method="post" action="/profile/addresses" class="form-grid"><input name="label" placeholder="Nhãn: Nhà riêng, Văn phòng..."><input name="recipient_name" placeholder="Người nhận" required><input name="phone" placeholder="Số điện thoại"><input name="address_line" placeholder="Địa chỉ đầy đủ" required><label class="checkline"><input type="checkbox" name="is_default"> Đặt làm địa chỉ mặc định</label><button class="btn">+ Thêm địa chỉ</button></form></section>
<section class="panel"><div class="section-head"><div><h2>Lịch sử mua hàng</h2><p class="panel-subtitle">Đơn mới nhất được hiển thị trước.</p></div><span class="badge"><%= orders.length %> đơn</span></div><% if(orders.length){ %><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Ngày mua</th><th>Sản phẩm</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><b><%= o.order_number %></b></td><td><%= dateTime(o.created_at) %></td><td><div class="order-items-mini"><% o.items.forEach(i=>{ %><span><%= i.product_name %> (<%= i.variant_name %>) × <b><%= i.quantity %></b></span><% }) %></div></td><td><b><%= money(o.total) %></b></td><td><span class="status status-<%= o.status %>"><%= o.status %></span></td><td><a class="link" href="/orders/<%= o.order_number %>">Chi tiết →</a></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><div class="empty-icon">▤</div><h3>Chưa có đơn hàng</h3><p>Khi bạn mua sản phẩm, lịch sử sẽ xuất hiện tại đây.</p><a class="btn" href="/products">Mua sắm ngay</a></div><% } %></section>
<%- include('partials/footer') %>
