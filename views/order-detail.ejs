<%- include('partials/header',{title:'Đơn '+order.order_number+' - ComputerHub'}) %>
<% if(typeof success!=='undefined' && success){ %><div class="order-success"><span class="success-icon">✓</span><div><h2>Đặt hàng thành công!</h2><p>Đơn <b><%= order.order_number %></b> đã được ghi nhận. <% if(typeof guestReceipt!=='undefined' && guestReceipt){ %>Bạn có thể lưu trang này làm biên nhận tạm thời.<% } %></p></div></div><% } %>
<nav class="breadcrumbs"><a href="/">Trang chủ</a><span>›</span><% if(user){ %><a href="/profile">Tài khoản</a><span>›</span><% } %><span><%= order.order_number %></span></nav>
<div class="section-head"><div class="section-head-copy"><span class="kicker">Order details</span><h1 class="page-title">Đơn hàng <%= order.order_number %></h1><p>Thông tin mua hàng và lịch sử trạng thái được lưu theo từng mốc thời gian.</p></div><span class="status status-<%= order.status %>"><%= order.status %></span></div>
<div class="dashboard-grid">
  <section class="panel"><h2>Thông tin đơn</h2><div class="order-meta-grid"><div class="order-meta"><small>Ngày đặt</small><b><%= dateTime(order.created_at) %></b></div><div class="order-meta"><small>Phương thức</small><b><%= order.payment_method %></b></div><div class="order-meta"><small>Người nhận</small><b><%= order.shipping_name %></b><div class="small muted"><%= order.shipping_phone %></div></div><div class="order-meta"><small>Giao tới</small><b><%= order.shipping_address %></b></div></div><div style="margin-top:14px"><div class="summary-line"><span>Tạm tính</span><b><%= money(order.subtotal) %></b></div><div class="summary-line"><span>Thuế</span><b><%= money(order.tax) %></b></div><div class="summary-line"><span>Vận chuyển</span><b><%= order.shipping_fee?money(order.shipping_fee):'Miễn phí' %></b></div><% if(order.discount_amount){ %><div class="summary-line"><span>Giảm giá <%= order.discount_code?'('+order.discount_code+')':'' %></span><b>−<%= money(order.discount_amount) %></b></div><% } %><% if(order.points_used){ %><div class="summary-line"><span>Điểm đã dùng</span><b>−<%= money(order.points_used*POINT_VALUE_VND) %></b></div><% } %><div class="summary-line total"><span>Tổng thanh toán</span><b><%= money(order.total) %></b></div></div></section>
  <section class="panel"><h2>Lịch sử trạng thái</h2><% history.forEach(h=>{ %><div class="timeline"><b><span class="status status-<%= h.status %>"><%= h.status %></span></b><small><%= dateTime(h.created_at) %></small></div><% }) %></section>
</div>
<section class="panel"><h2>Sản phẩm trong đơn</h2><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Biến thể</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.product_name %></b></td><td><%= i.variant_name %></td><td><%= i.quantity %></td><td><%= money(i.unit_price) %></td><td><b><%= money(i.unit_price*i.quantity) %></b></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/footer') %>
