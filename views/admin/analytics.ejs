<%- include('../partials/header',{title:'Advanced Dashboard - ComputerHub'}) %>
<%- include('_nav') %>
<div class="admin-head"><div><span class="kicker">Performance analytics</span><h1 class="page-title">Thống kê nâng cao</h1><p>Chuyển đổi giữa năm, quý, tháng, tuần hoặc giới hạn theo khoảng ngày.</p></div></div>
<section class="panel"><form class="inline-form"><div><label>Chu kỳ</label><select name="mode"><option value="year" <%= mode==='year'?'selected':'' %>>Theo năm</option><option value="quarter" <%= mode==='quarter'?'selected':'' %>>Theo quý</option><option value="month" <%= mode==='month'?'selected':'' %>>Theo tháng</option><option value="week" <%= mode==='week'?'selected':'' %>>Theo tuần</option></select></div><div><label>Từ ngày</label><input type="date" name="start" value="<%= start %>"></div><div><label>Đến ngày</label><input type="date" name="end" value="<%= end %>"></div><button class="btn">Áp dụng</button><a class="btn secondary" href="/admin/analytics">Đặt lại</a></form></section>
<% const sums=rows.reduce((a,r)=>({orders:a.orders+Number(r.orders||0),revenue:a.revenue+Number(r.revenue||0),profit:a.profit+Number(r.profit||0),products:a.products+Number(r.products||0)}),{orders:0,revenue:0,profit:0,products:0}); %>
<div class="analytics-kpis"><div class="mini-kpi"><small>Số đơn trong kỳ</small><b><%= sums.orders %></b></div><div class="mini-kpi"><small>Doanh thu</small><b><%= money(sums.revenue) %></b></div><div class="mini-kpi"><small>Lợi nhuận</small><b><%= money(sums.profit) %></b></div><div class="mini-kpi"><small>Sản phẩm đã bán</small><b><%= sums.products %></b></div></div>
<section class="panel"><div class="section-head"><div><h2>So sánh theo thời gian</h2><p class="panel-subtitle">Doanh thu, lợi nhuận, số đơn, số sản phẩm và số loại sản phẩm bán ra.</p></div></div><div class="chart-box" style="height:420px"><canvas id="analytics"></canvas></div></section>
<section class="panel"><h2>Dữ liệu chi tiết</h2><div class="table-wrap"><table><thead><tr><th>Giai đoạn</th><th>Đơn</th><th>Sản phẩm</th><th>Loại sản phẩm</th><th>Doanh thu</th><th>Lợi nhuận</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><b><%= r.label %></b></td><td><%= r.orders %></td><td><%= r.products %></td><td><%= r.types %></td><td><%= money(r.revenue) %></td><td><%= money(r.profit) %></td></tr><% }) %></tbody></table></div></section>
<script src="/vendor/chartjs/chart.umd.js"></script>
<script>
(function(){
 const canvas=document.getElementById('analytics'); if(!canvas||!window.Chart)return; let chart;
 function build(){ if(chart)chart.destroy(); const s=getComputedStyle(document.documentElement), text=s.getPropertyValue('--muted').trim(), line=s.getPropertyValue('--line').trim(); chart=new Chart(canvas,{type:'line',data:{labels:<%- JSON.stringify(rows.map(x=>x.label)) %>,datasets:[{label:'Doanh thu',data:<%- JSON.stringify(rows.map(x=>x.revenue)) %>,borderColor:s.getPropertyValue('--primary').trim(),tension:.35,yAxisID:'money'},{label:'Lợi nhuận',data:<%- JSON.stringify(rows.map(x=>x.profit)) %>,borderColor:s.getPropertyValue('--success').trim(),tension:.35,yAxisID:'money'},{label:'Số đơn',data:<%- JSON.stringify(rows.map(x=>x.orders)) %>,borderColor:s.getPropertyValue('--warning').trim(),tension:.35,yAxisID:'count'},{label:'Sản phẩm bán',data:<%- JSON.stringify(rows.map(x=>x.products)) %>,borderColor:s.getPropertyValue('--accent').trim(),tension:.35,yAxisID:'count'},{label:'Loại sản phẩm',data:<%- JSON.stringify(rows.map(x=>x.types)) %>,borderColor:s.getPropertyValue('--primary-2').trim(),tension:.35,yAxisID:'count'}]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{labels:{color:text}}},scales:{x:{ticks:{color:text},grid:{color:line}},money:{type:'linear',position:'left',ticks:{color:text},grid:{color:line}},count:{type:'linear',position:'right',beginAtZero:true,ticks:{color:text,precision:0},grid:{drawOnChartArea:false}}}}}); }
 build(); document.addEventListener('themechange',build);
})();
</script>
<%- include('../partials/footer') %>
