<%- include('../partials/header',{title:'Quản lý sản phẩm - ComputerHub'}) %>
<%- include('_nav') %>
<div class="admin-head"><div><span class="kicker">Catalog management</span><h1 class="page-title">Sản phẩm, danh mục & tồn kho</h1><p>Thêm, sửa, xóa sản phẩm; quản lý category và tồn kho từng variant trong cùng một khu vực.</p></div><span class="badge"><%= products.length %> sản phẩm</span></div>
<div class="manage-grid">
  <div>
    <section class="panel"><h2>Danh sách sản phẩm</h2><p class="panel-subtitle">Mở “Chỉnh sửa” để cập nhật thông tin và giá/tồn kho của từng biến thể.</p><% products.forEach(p=>{ const pv=variants.filter(v=>v.product_id===p.id); const pi=images.filter(img=>img.product_id===p.id).slice(0,3); %><article class="product-admin-card"><div class="product-admin-head"><div><h3><%= p.name %></h3><div class="product-admin-meta"><%= p.brand %> • <%= p.category_name %> • <%= p.variant_count %> biến thể • tồn <%= p.total_stock %></div></div><div style="text-align:right"><b><%= money(p.base_price) %></b><div><span class="badge <%= p.active ? (p.is_new?'success':'') : 'warning' %>"><%= p.active ? (p.is_new?'Mới':'Đang bán') : 'Đã ẩn' %></span></div></div></div><details class="details-box"><summary>Chỉnh sửa sản phẩm & tồn kho</summary><form method="post" action="/admin/products/<%= p.id %>/update" class="form-grid" style="margin-top:12px"><input name="name" value="<%= p.name %>" required><input name="brand" value="<%= p.brand %>" required><select name="category_id"><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= c.id===p.category_id?'selected':'' %>><%= c.name %></option><% }) %></select><div><label>Giá từ biến thể (được tự động đồng bộ)</label><input type="number" value="<%= p.base_price %>" readonly title="Hãy cập nhật Giá bán trong phần Biến thể & tồn kho phía dưới"></div><input class="full" name="short_description" value="<%= p.short_description %>" required><textarea name="long_description" rows="6" required><%= p.long_description %></textarea><input name="image1" value="<%= pi[0]?.url||'' %>" placeholder="Ảnh 1 URL"><input name="image2" value="<%= pi[1]?.url||'' %>" placeholder="Ảnh 2 URL"><input name="image3" value="<%= pi[2]?.url||'' %>" placeholder="Ảnh 3 URL"><label class="checkline"><input type="checkbox" name="is_new" <%= p.is_new?'checked':'' %>> Sản phẩm mới</label><button class="btn">Lưu sản phẩm</button></form><div style="margin-top:14px"><b class="small">Biến thể & tồn kho</b><% pv.forEach(v=>{ %><form method="post" action="/admin/variants/<%= v.id %>/update" class="variant-row"><div><b><%= v.name %></b><div class="small muted"><%= v.sku %></div></div><div><label>Giá bán</label><input type="number" name="price" value="<%= v.price %>" min="0"></div><div><label>Giá vốn</label><input type="number" name="cost_price" value="<%= v.cost_price %>" min="0"></div><div><label>Tồn kho</label><input type="number" name="stock" value="<%= v.stock %>" min="0"></div><button class="btn secondary small-btn">Cập nhật</button></form><% }) %></div><% if(p.active){ %><form method="post" action="/admin/products/<%= p.id %>/delete" style="margin-top:12px" data-confirm="Ẩn sản phẩm <%= p.name %> khỏi cửa hàng? Lịch sử đơn sẽ được giữ lại."><button class="danger">Ẩn khỏi cửa hàng</button></form><% } else { %><form method="post" action="/admin/products/<%= p.id %>/restore" style="margin-top:12px"><button class="btn secondary">Khôi phục sản phẩm</button></form><% } %></details></article><% }) %></section>
  </div>
  <aside>
    <section class="panel"><h2>Thêm sản phẩm</h2><p class="panel-subtitle">Hệ thống tự tạo 2 variants và đảm bảo 3 ảnh minh họa.</p><form method="post"><input name="name" placeholder="Tên sản phẩm" required><input name="slug" placeholder="Slug, ví dụ ultra-laptop-15"><input name="brand" placeholder="Thương hiệu" required><select name="category_id"><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select><input type="number" name="base_price" min="0" placeholder="Giá cơ bản (VND)" required><input name="short_description" placeholder="Mô tả ngắn" required><textarea name="long_description" rows="6" placeholder="Mô tả chi tiết tối thiểu 5 dòng (mỗi ý một dòng)" required></textarea><input name="image1" placeholder="Ảnh 1 URL (để trống dùng ảnh mẫu)"><input name="image2" placeholder="Ảnh 2 URL"><input name="image3" placeholder="Ảnh 3 URL"><label class="checkline"><input type="checkbox" name="is_new"> Đánh dấu sản phẩm mới</label><button class="btn">+ Thêm sản phẩm</button></form></section>
    <section class="panel"><h2>Quản lý danh mục</h2><form method="post" action="/admin/categories"><input name="name" placeholder="Tên danh mục" required><input name="slug" placeholder="Slug (có thể để trống)"><button class="btn">+ Thêm danh mục</button></form><div class="category-manage" style="margin-top:16px"><% categories.forEach(c=>{ %><div class="product-admin-card"><form method="post" action="/admin/categories/<%= c.id %>/update" class="category-row-admin"><input name="name" value="<%= c.name %>"><input name="slug" value="<%= c.slug %>"><button class="btn secondary small-btn">Lưu</button></form><div class="button-row" style="justify-content:space-between;margin-top:8px"><span class="small muted"><%= c.active_product_count %> đang bán / <%= c.product_count %> tổng</span><form method="post" action="/admin/categories/<%= c.id %>/delete" data-confirm="Chỉ xóa được danh mục không có sản phẩm. Tiếp tục?"><button class="danger">Xóa</button></form></div></div><% }) %></div></section>
  </aside>
</div>
<%- include('../partials/footer') %>
