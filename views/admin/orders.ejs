<%- include('../partials/header',{title:'Quản lý đơn hàng - ComputerHub'}) %>
<%- include('_nav') %>
<div class="admin-head"><div><span class="kicker">Order management</span><h1 class="page-title">Đơn hàng</h1><p>Mới nhất hiển thị trước, tối đa 20 đơn mỗi trang và có bộ lọc thời gian.</p></div><span class="badge"><%= total %> đơn</span></div>
<section class="panel"><form class="inline-form"><div><label>Khoảng nhanh</label><select name="range"><option value="">Tất cả</option><option value="today" <%= filters.range==='today'?'selected':'' %>>Hôm nay</option><option value="yesterday" <%= filters.range==='yesterday'?'selected':'' %>>Hôm qua</option><option value="week" <%= filters.range==='week'?'selected':'' %>>7 ngày gần đây</option><option value="month" <%= filters.range==='month'?'selected':'' %>>Tháng này</option></select></div><div><label>Từ ngày</label><input type="date" name="start" value="<%= filters.start||'' %>"></div><div><label>Đến ngày</label><input type="date" name="end" value="<%= filters.end||'' %>"></div><button class="btn">Lọc</button><a class="btn secondary" href="/admin/orders">Đặt lại</a></form></section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách</th><th>Ngày</th><th>Tổng</th><th>Trạng thái</th><th></th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><b><%= o.order_number %></b></td><td><%= o.buyer %></td><td><%= dateTime(o.created_at) %></td><td><b><%= money(o.total) %></b></td><td><span class="status status-<%= o.status %>"><%= o.status %></span></td><td><a class="link" href="/admin/orders/<%= o.id %>">Chi tiết →</a></td></tr><% }) %></tbody></table></div><div class="pagination" style="margin:18px 0 0"><% for(let i=1;i<=pages;i++){ %><a class="<%= i===page?'active':'' %>" href="?<%= new URLSearchParams({...filters,page:i}).toString() %>"><%= i %></a><% } %></div></section>
<%- include('../partials/footer') %>
