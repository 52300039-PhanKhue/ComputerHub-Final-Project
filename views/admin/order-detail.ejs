<%- include('../partials/header',{title:'Chi tiết đơn '+order.order_number}) %>
<%- include('_nav') %>
<nav class="breadcrumbs"><a href="/admin/orders">Đơn hàng</a><span>›</span><span><%= order.order_number %></span></nav>
<div class="admin-head"><div><span class="kicker">Order detail</span><h1 class="page-title"><%= order.order_number %></h1><p><%= order.buyer %> • <%= order.email %> • <%= dateTime(order.created_at) %></p></div><span class="status status-<%= order.status %>"><%= order.status %></span></div>
<div class="dashboard-grid"><section class="panel"><h2>Khách & thanh toán</h2><div class="order-meta-grid"><div class="order-meta"><small>Người mua</small><b><%= order.buyer %></b><div class="small muted"><%= order.email %></div></div><div class="order-meta"><small>Người nhận</small><b><%= order.shipping_name %></b><div class="small muted"><%= order.shipping_phone %></div></div><div class="order-meta"><small>Mã giảm giá</small><b><%= order.discount_code||'Không áp dụng' %></b></div><div class="order-meta"><small>Phương thức</small><b><%= order.payment_method %></b></div></div><p class="small muted">Địa chỉ: <%= order.shipping_address %></p><div class="summary-line"><span>Tạm tính</span><b><%= money(order.subtotal) %></b></div><div class="summary-line"><span>Giảm giá</span><b>−<%= money(order.discount_amount) %></b></div><div class="summary-line"><span>Điểm đã dùng</span><b><%= order.points_used %> điểm</b></div><div class="summary-line total"><span>Tổng</span><b><%= money(order.total) %></b></div></section><section class="panel"><h2>Cập nhật trạng thái</h2><form method="post" action="/admin/orders/<%= order.id %>/status"><select name="status"><% ['pending','confirmed','shipping','delivered'].forEach(s=>{ %><option value="<%= s %>" <%= order.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn">Cập nhật trạng thái</button></form><h3 style="margin-top:22px">Lịch sử</h3><% history.forEach(h=>{ %><div class="timeline"><span class="status status-<%= h.status %>"><%= h.status %></span><small><%= dateTime(h.created_at) %></small></div><% }) %></section></div>
<section class="panel"><h2>Sản phẩm</h2><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Biến thể</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.product_name %></b></td><td><%= i.variant_name %></td><td><%= i.quantity %></td><td><%= money(i.unit_price) %></td><td><b><%= money(i.unit_price*i.quantity) %></b></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/footer') %>
