<%- include('../partials/header',{title:'Quản lý người dùng - ComputerHub'}) %>
<%- include('_nav') %>
<div class="admin-head"><div><span class="kicker">Customer management</span><h1 class="page-title">Người dùng</h1><p>Xem, cập nhật thông tin khách hàng và khóa/mở khóa tài khoản.</p></div><span class="badge"><%= users.length %> khách hàng</span></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Khách hàng</th><th>Email</th><th>Điểm</th><th>Ngày tạo</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><form id="user-<%= u.id %>" method="post" action="/admin/users/<%= u.id %>/update"><input name="full_name" value="<%= u.full_name %>" required></form></td><td><input form="user-<%= u.id %>" type="email" name="email" value="<%= u.email %>" required></td><td><b><%= u.loyalty_points %></b></td><td><%= dateTime(u.created_at) %></td><td><span class="badge <%= u.banned?'danger':'success' %>"><%= u.banned?'Bị khóa':'Hoạt động' %></span></td><td><div class="button-row"><button form="user-<%= u.id %>" class="btn secondary small-btn">Lưu</button><form method="post" action="/admin/users/<%= u.id %>/ban"><button class="<%= u.banned?'btn small-btn':'danger' %>"><%= u.banned?'Mở khóa':'Khóa' %></button></form></div></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/footer') %>
