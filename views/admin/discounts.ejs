<%- include('../partials/header',{title:'Mã giảm giá - ComputerHub'}) %>
<%- include('_nav') %>
<div class="admin-head"><div><span class="kicker">Discount management</span><h1 class="page-title">Mã giảm giá</h1><p>Tạo mã đúng 5 ký tự chữ/số, theo dõi lượt sử dụng và các đơn đã áp dụng.</p></div></div>
<div class="manage-grid"><section class="panel"><h2>Danh sách mã</h2><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Mức giảm</th><th>Đã dùng</th><th>Tạo lúc</th><th></th></tr></thead><tbody><% discounts.forEach(d=>{ %><tr><td><span class="promo-code" style="display:inline-block;padding:7px 10px"><%= d.code %></span></td><td><b><%= d.percent_off %>%</b></td><td><%= d.used_count %>/<%= d.max_uses %></td><td><%= dateTime(d.created_at) %></td><td><a class="link" href="/admin/discounts/<%= d.code %>/orders">Xem đơn →</a></td></tr><% }) %></tbody></table></div></section><aside><section class="panel"><h2>Tạo mã mới</h2><p class="panel-subtitle">Giới hạn tối đa theo đề là 10 lượt sử dụng cho mỗi code.</p><form method="post"><label>Mã 5 ký tự</label><input name="code" minlength="5" maxlength="5" pattern="[A-Za-z0-9]{5}" placeholder="ABCDE" style="text-transform:uppercase" required><label>Phần trăm giảm</label><input type="number" name="percent_off" min="1" max="100" placeholder="5" required><label>Lượt dùng tối đa</label><input type="number" name="max_uses" min="1" max="10" placeholder="10" required><button class="btn">+ Tạo mã</button></form></section></aside></div>
<%- include('../partials/footer') %>
