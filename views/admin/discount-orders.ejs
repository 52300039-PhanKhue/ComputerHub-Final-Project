<%- include('../partials/header',{title:'Đơn dùng mã '+code+' - ComputerHub'}) %>
<%- include('_nav') %>
<nav class="breadcrumbs"><a href="/admin/discounts">Mã giảm giá</a><span>›</span><span><%= code %></span></nav>
<div class="admin-head"><div><span class="kicker">Coupon usage</span><h1 class="page-title">Đơn dùng mã <%= code %></h1><p>Danh sách các đơn hàng đã áp dụng coupon này.</p></div></div>
<section class="panel"><% if(orders.length){ %><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Tổng</th><th>Giảm</th><th>Ngày</th><th>Trạng thái</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><b><%= o.order_number %></b></td><td><%= money(o.total) %></td><td>−<%= money(o.discount_amount) %></td><td><%= dateTime(o.created_at) %></td><td><span class="status status-<%= o.status %>"><%= o.status %></span></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><div class="empty-icon">%</div><h3>Chưa có đơn sử dụng mã này</h3><p>Khi khách áp dụng mã ở checkout, đơn hàng sẽ xuất hiện tại đây.</p></div><% } %></section>
<%- include('../partials/footer') %>
